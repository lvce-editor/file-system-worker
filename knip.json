{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/build.js", "src/build-static.js", "src/computeNodeModulesCacheKey.js", "src/dev.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["esbuild"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/file-system-worker": {
      "entry": ["src/fileSystemWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreExportsUsedInFile": true
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/postinstall.js"],
      "project": ["src/**/*.js"]
    }
  }
}
